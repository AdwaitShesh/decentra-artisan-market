# Vite environment variables for Decentra Artisan Market
# Copy this file to `.env` (or `.env.local`) and fill in values as needed

# ===========================================
# OPTION 1: Single Network (Current Setup)
# ===========================================
# Use this if you want to run on single Hardhat node with UI simulation
VITE_NFT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_MARKETPLACE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# ===========================================
# OPTION 2: True Multi-Network (Advanced)
# ===========================================
# Use these if you want to run multiple Hardhat nodes with real network switching
# Run: cd contracts && ./scripts/start-networks.sh
# Then: cd contracts && node scripts/deploy-all.js

# Individual contract addresses for each network (set after deployment)
# VITE_ETHEREUM_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# VITE_POLYGON_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# VITE_BASE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Marketplace contract addresses for each network
# VITE_ETHEREUM_MARKETPLACE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# VITE_POLYGON_MARKETPLACE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# VITE_BASE_MARKETPLACE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Network Configuration
# Ethereum: http://127.0.0.1:8545 (Chain ID: 1337)
# Polygon:  http://127.0.0.1:8546 (Chain ID: 1338)
# Base:     http://127.0.0.1:8547 (Chain ID: 1341)
